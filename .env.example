GROQ_API_KEY=
OPENROUTER_API_KEY=
# Use the exact GLM model ID available in your OpenRouter account.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
GROQ_STT_MODEL=whisper-large-v3-turbo

# Use a local openWakeWord .onnx model trained for EDITH, or set this to spoken
# for a temporary STT-based fallback.
WAKEWORD_ENGINE=openwakeword
WAKEWORD_MODEL_PATH=models/edith.onnx
WAKEWORD_THRESHOLD=0.5
# If WAKEWORD_ENGINE=openwakeword and the model is missing, EDITH falls back
# to spoken wake commands: "EDITH ..." or "hey EDITH ...".
WAKEWORD_TEST_MODE=0
# Set WAKEWORD_TEST_MODE=1 to print transcript + wake detection signal without
# requiring OPENROUTER_API_KEY.

AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
# Pause length that ends an utterance. Increase this if you think while speaking.
SILENCE_SECONDS=1.8
MAX_RECORDING_SECONDS=15
FOLLOW_UP_SECONDS=30
# After EDITH speaks, return to wake-word mode if no follow-up starts within this time.
FOLLOW_UP_LISTEN_TIMEOUT_SECONDS=3
MIN_VOICED_FRAMES=3
MIN_AUDIO_RMS=300
PLAYBACK_COOLDOWN_SECONDS=0.5
# Optional numeric PortAudio device index.
MICROPHONE_DEVICE=

# Google Drive OAuth desktop-client JSON and local OAuth token cache.
# Conversation and memory data are stored in Drive, not on this machine.
GOOGLE_DRIVE_CREDENTIALS_FILE=credentials.json
GOOGLE_DRIVE_TOKEN_FILE=.edith-drive-token.json
GOOGLE_DRIVE_FOLDER=EDITH
REMINDER_ADVANCE_MINUTES=15
REMINDER_INTERVAL_SECONDS=15
DAILY_PROMPT_HOUR=7
DAILY_PROMPT_MINUTE=0
DAILY_PROMPT_RETRY_MINUTES=15
