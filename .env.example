GROQ_API_KEY=
OPENROUTER_API_KEY=
# Use the exact GLM model ID available in your OpenRouter account.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
GROQ_STT_MODEL=whisper-large-v3-turbo

# Use a local openWakeWord .onnx model trained for EDITH, or set this to spoken
# for a temporary STT-based fallback.
WAKEWORD_ENGINE=openwakeword
WAKEWORD_MODEL_PATH=models/edith.onnx
WAKEWORD_THRESHOLD=0.5
# If WAKEWORD_ENGINE=openwakeword and the model is missing, EDITH falls back
# to spoken wake commands: "EDITH ..." or "hey EDITH ...".
WAKEWORD_TEST_MODE=0
# Set WAKEWORD_TEST_MODE=1 to print transcript + wake detection signal without
# requiring OPENROUTER_API_KEY.

AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
# Pause length that ends an utterance. Increase this if you think while speaking.
SILENCE_SECONDS=1.8
MAX_RECORDING_SECONDS=15
FOLLOW_UP_SECONDS=30
# After EDITH speaks, return to wake-word mode if no follow-up starts within this time.
FOLLOW_UP_LISTEN_TIMEOUT_SECONDS=3
MIN_VOICED_FRAMES=3
MIN_AUDIO_RMS=300
PLAYBACK_COOLDOWN_SECONDS=0.5
# Optional numeric PortAudio device index.
MICROPHONE_DEVICE=

# Google Drive OAuth desktop-client JSON and local OAuth token cache.
# Conversation and memory data are stored in Drive, not on this machine.
GOOGLE_DRIVE_CREDENTIALS_FILE=credentials.json
GOOGLE_DRIVE_TOKEN_FILE=.edith-drive-token.json
GOOGLE_DRIVE_FOLDER=EDITH
REMINDER_ADVANCE_MINUTES=15
REMINDER_INTERVAL_SECONDS=15
DAILY_PROMPT_HOUR=7
DAILY_PROMPT_MINUTE=0
DAILY_PROMPT_RETRY_MINUTES=15

# Optional local webcam presence. Disabled by default; no images are stored or uploaded.
CAMERA_PRESENCE_ENABLED=0
CAMERA_INDEX=0
CAMERA_SAMPLE_INTERVAL_SECONDS=5
# Optional local-time camera power schedule. When both are set, the webcam is
# released for this interval and reopened when the active window begins.
CAMERA_QUIET_START=
CAMERA_QUIET_END=
CAMERA_MIN_CONSECUTIVE_DETECTIONS=2
CAMERA_MIN_CONSECUTIVE_ABSENCE=3

# Optional local owner verification. Disabled by default. This stores only a
# face encoding in this local file; no frames are recorded or uploaded.
OWNER_VERIFICATION_ENABLED=0
OWNER_ENCODING_FILE=.edith-owner.json
OWNER_FACE_TOLERANCE=0.48
# Explicit opt-in: unknown visitors are recorded temporarily and uploaded to Drive.
VISITOR_RECORDING_ENABLED=false
VISITOR_DRIVE_COLLECTION=visitor-recordings
VISITOR_MAX_SESSION_DURATION_SECONDS=120
VISITOR_RECORDING_ANNOUNCEMENT=This room is monitored. Recording has started.
VISITOR_RETENTION_METADATA=Delete visitor recordings when no longer needed.
VISITOR_RETENTION_DAYS=30
# Audio is captured only while an unknown visitor video is active. It uses a
# second sounddevice stream (and may be unavailable when the normal microphone
# is busy). ffmpeg muxes WAV audio into the MP4; failures fall back to video-only.
VISITOR_AUDIO_ENABLED=0
VISITOR_AUDIO_DEVICE=
VISITOR_AUDIO_SAMPLE_RATE=16000
VISITOR_AUDIO_CODEC=aac
VISITOR_FFMPEG_PATH=ffmpeg
OWNER_RETURN_AFTER_MINUTES=30

# Optional Phase 3 local study-session estimates. Disabled by default. Regions
# are normalized x,y,width,height values relative to the camera frame.
STUDY_OBSERVER_ENABLED=0
STUDY_DESK_REGION=0,0.5,0.5,0.5
STUDY_BED_REGION=0.5,0.5,0.5,0.5
STUDY_MOTION_THRESHOLD=0.08
STUDY_MIN_CONFIDENCE=0.5
# A slot with study=true/is_study=true is always a study slot. Otherwise one
# of these case-insensitive title fragments must match.
STUDY_SLOT_TITLE_PATTERNS=study,studying,leetcode,revision
